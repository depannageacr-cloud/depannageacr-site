DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^blog/?$ /advies/ [R=301,L]
RewriteRule ^transport\-tractor/?$ /transport-landbouwmachines/ [R=301,L]
RewriteRule ^tractor\-vervoer/?$ /transport-landbouwmachines/ [R=301,L]
RewriteRule ^depannage\-in\-de\-buurt/?$ /takeldienst-in-de-buurt/ [R=301,L]
RewriteRule ^autopanne/?$ /autopech/ [R=301,L]
RewriteRule ^page/takeldienstbedrijf\-plaats\-een\-nieuwe\-veranda/?$ - [G,L]
RewriteRule ^page/insulineresistentie\-en\-autopech/?$ - [G,L]
RewriteRule ^page/takeldienstbedrijf\-investeert\-in\-een\-woning\-in\-spanje\-voor\-een\-vleugje\-luxe/?$ - [G,L]
RewriteRule ^auto\-huren\-oost\-vlaanderen/?$ - [G,L]
RewriteRule ^2023/12/?$ - [G,L]
RewriteRule ^author/admin/?$ - [G,L]
RewriteRule ^bestelwagen\-huren\-oost\-vlaanderen/?$ - [G,L]
RewriteRule ^aanhangwagen\-huren\-oost\-vlaanderen/?$ - [G,L]
RewriteRule ^2023/09/?$ - [G,L]
RewriteRule ^category/page/?$ - [G,L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
SetEnvIfNoCase Host "^(?!((www\.)?depannageoostvlaanderen\.be)$)" is_preview
Header set X-Robots-Tag "noindex, nofollow" env=is_preview
</IfModule>
